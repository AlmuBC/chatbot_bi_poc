# Copia este archivo como ".env" y rellena tus valores.

# --- Selección de proveedor de LLM ---
# Cuál de los archivos de conexión en llm/ se usa (config en config/providers/).
# "opencode" es el único activo y probado en este PoC; "anthropic" y "openai"
# son plantillas de ejemplo para el día que se quiera migrar (solo hace falta
# rellenar sus variables más abajo y cambiar esto).
LLM_PROVIDER=opencode

# --- Proveedor: opencode (activo por defecto) ---
# La API key la sacas en https://opencode.ai/auth (sección "Zen" o "Go" según tu suscripción)
OPENCODE_API_KEY=tu_api_key_aqui

# Endpoint OpenAI-compatible de OpenCode:
#   - Suscripción "Go" (mensual, la que ya pagas):  https://opencode.ai/zen/go/v1
#   - Zen "pay as you go" (saldo/cash balance):      https://opencode.ai/zen/v1
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# ID exacto del modelo. Compruébalo ejecutando `opencode` y escribiendo /models,
# o revisando la lista de modelos incluidos en tu plan Go (ej: GLM-5.2, DeepSeek V4 Flash,
# Qwen3.7 Plus, MiniMax M2.7...). Copia el identificador tal cual aparece.
OPENCODE_MODEL=glm-5.2

# --- Proveedor: anthropic (EJEMPLO, no activo por defecto) ---
# Solo hace falta rellenar esto si pones LLM_PROVIDER=anthropic. Requiere
# además `pip install anthropic`. API key en https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=tu_api_key_aqui
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4096

# --- Proveedor: openai (EJEMPLO, no activo por defecto) ---
# Solo hace falta rellenar esto si pones LLM_PROVIDER=openai. API key en
# https://platform.openai.com/api-keys (distinta de OPENCODE_API_KEY aunque
# ambos usen el mismo SDK).
# OPENAI_API_KEY=tu_api_key_aqui
# OPENAI_MODEL=gpt-5.1
# OPENAI_BASE_URL=

# Rutas a los ficheros de datos (no suele hacer falta tocarlas)
EXCEL_PATH=data/marketing_performance_1000_t2o.xlsx
SEMANTIC_LAYER_PATH=data/semantic_layer.yaml

# --- Google Chat (servidor webhook) ---
# Número de proyecto de Google Cloud (lo ves en la pestaña "Configuración" de la
# Chat API, arriba del todo: "Número de proyecto (ID de app): ...")
GOOGLE_CHAT_PROJECT_NUMBER=412498053781

# URL pública completa del webhook (incluyendo el "/googlechat" final), tal cual
# está puesta AHORA MISMO en "URL del extremo HTTP" en la configuración de la
# Chat App en Google Cloud Console. Google firma el token con esa URL exacta
# como "audience", así que debe coincidir carácter por carácter. Actualízala
# cada vez que cambie la URL del túnel (cloudflared, devtunnel, etc.).
GOOGLE_CHAT_WEBHOOK_URL=https://tu-url-de-tunel.example.com/googlechat

# Puerto donde escuchará el servidor local (el mismo que le pases a cloudflared)
PORT=8080

# Pon esto en "false" solo si quieres depurar rápido sin verificar que la petición
# viene realmente de Google (NO recomendado dejarlo así una vez todo funcione).
GOOGLE_CHAT_VERIFY_REQUESTS=true

# Clave secreta para pseudonimizar (HMAC-SHA256) el email del usuario antes de
# guardarlo en logs/interactions.jsonl. Genera la tuya con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin este secreto no se puede reconstruir ni verificar el email a partir del log.
LOG_USER_ID_SECRET=genera_tu_propia_clave_aleatoria_aqui

# --- Memoria de conversación de corto plazo (context.py) ---
# Cuántas interacciones previas del mismo thread_id (leídas de
# logs/interactions.jsonl) se incluyen como historial en cada llamada al LLM.
CONTEXT_MAX_TURNS=3

# Si la última interacción registrada de ese thread_id tiene más antigüedad que
# esto (en minutos), no se incluye historial: se trata como conversación nueva.
CONTEXT_INACTIVITY_MINUTES=20
